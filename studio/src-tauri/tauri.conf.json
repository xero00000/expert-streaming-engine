{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESE Studio",
  "version": "0.2.0",
  "identifier": "io.github.xero00000.ese-studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ESE Studio — Expert Streaming Engine",
        "width": 1180,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "license": "MIT",
    "licenseFile": "../../THIRD_PARTY_NOTICES.txt",
    "resources": {
      "../runtime/ese/": "ese/",
      "../../LICENSE": "licenses/ESE-MIT-LICENSE.txt",
      "../../THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt",
      "../licenses/NVIDIA-CUDA-12.4-LICENSE.txt": "licenses/NVIDIA-CUDA-12.4-LICENSE.txt"
    },
    "windows": {
      "wix": {
        "template": "wix/main.wxs"
      },
      "nsis": {
        "template": "installer.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCRDZBNTM1NDM2QjZBMgpSV1NpdGpaVVUycTlCMWREeXBJQWFOWU45Q0xpZE0xTDZhcjBuMy9hdWhmc1FFeGtsZVpOd1YxSwo=",
      "endpoints": [
        "https://github.com/xero00000/expert-streaming-engine/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
